	"scripts": {
		"android": "expo run:android",
		"build:android": "eas build --local --platform android --profile production",
		"build:ios": "eas build --local --platform ios --profile production",
		"dev": "expo start --dev-client --lan",
		"dev:android": "expo run:android --device",
		"dev:ios": "expo run:ios --device",
		"ios": "expo run:ios",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"prebuild": "expo prebuild",
		"prebuild:clean": "expo prebuild --clean",
		"publish:android": "eas submit --platform android",
		"publish:ios": "eas submit --platform ios",
		"rinse": "npx --yes @tmlmobilidade/repo-rinse"
	},
