{

	"[css]": {
		"editor.codeActionsOnSave": {
			"source.fixAll.stylelint": "explicit"
		},
		"editor.defaultFormatter": "stylelint.vscode-stylelint"
	},

	// Disable the default CSS formatter, use stylelint instead
	"css.validate": false,

	// Auto fix
	"editor.codeActionsOnSave": {
		"source.fixAll.eslint": "explicit"
	},
	"editor.defaultFormatter": "dbaeumer.vscode-eslint",
	"editor.formatOnSave": false,
	"editor.tabSize": 4,

	"eslint.format.enable": true,

	// Enable eslint for all supported languages
	"eslint.validate": [
		"javascript",
		"javascriptreact",
		"typescript",
		"typescriptreact",
		"vue",
		"html",
		"markdown",
		"json",
		"jsonc",
		"yaml",
		"toml",
		"astro"
	],
	"eslint.workingDirectories": ["auto"],
	"files.eol": "\n",

	"less.validate": false,
	// Disable the default formatter, use eslint instead
	"prettier.enable": false,

	"scss.validate": false,

	"workbench.editor.customLabels.enabled": true,
	"workbench.editor.customLabels.patterns": {
		"**/components/**/*.css": "${dirname} (${extname})",
		"**/components/**/*.js": "${dirname} (${extname})",
		"**/components/**/*.tsx": "${dirname} (${extname})"
	},
	"i18n-ally.localesPaths": [
		"i18n",
		"ios/Pods/RCT-Folly/folly/lang",
		"ios/Pods/boost/boost/predef/language",
		"ios/Pods/Headers/Private/RCT-Folly/folly/lang",
		"ios/Pods/Headers/Public/RCT-Folly/folly/lang"
	],
	"i18next.i18nPaths": "/Users/brunocastelo/Developer/carrismetropolitana/app/i18n,/Users/brunocastelo/Developer/carrismetropolitana/app/i18n/translations,/Users/brunocastelo/Developer/carrismetropolitana/app/ios/Pods/RCT-Folly/folly/lang,/Users/brunocastelo/Developer/carrismetropolitana/app/ios/Pods/Headers/Private/RCT-Folly/folly/lang,/Users/brunocastelo/Developer/carrismetropolitana/app/ios/Pods/Headers/Public/RCT-Folly/folly/lang"

}
