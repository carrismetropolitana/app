{
	"expo": {
		"android": {
			"adaptiveIcon": {
				"backgroundColor": "#ffffff",
				"foregroundImage": "./assets/images/Logos/CM_Logo _Symbol_LightMode.png"
			},
			"googleServicesFile": "./configs/google-services-prod.json",
			"package": "pt.carrismetropolitana.mobile",
			"permissions": [
				"android.permission.ACCESS_COARSE_LOCATION",
				"android.permission.ACCESS_FINE_LOCATION",
				"android.permission.RECORD_AUDIO",
				"android.permission.MODIFY_AUDIO_SETTINGS"
			],
			"versionCode": 10092025
		},
		"assetBundlePatterns": [
			"assets/**/*"
		],
		"experiments": {
			"typedRoutes": true
		},
		"extra": {
			"eas": {
				"projectId": "aa327210-947a-4d53-bb3f-2c09c2f6cde5"
			},
			"router": {
				"origin": false
			}
		},
		"icon": "./assets/images/Logos/CM_Logo _Symbol_LightMode.png",
		"ios": {
			"appleTeamId": "QGATT2W97P",
			"bundleIdentifier": "pt.carrismetropolitana.app",
			"entitlements": {
				"aps-environment": "development"
			},
			"googleServicesFile": "./configs/GoogleService-Info.plist",
			"infoPlist": {
				"ITSAppUsesNonExemptEncryption": false,
				"NSUserNotificationUsageDescription": "Precisamos de enviar notificações para avisar sobre novidades.",
				"UIBackgroundModes": [
					"remote-notification"
				]
			},
			"jsEngine": "hermes",
			"supportsTablet": true
		},
		"jsEngine": "hermes",
		"name": "Carris Metropolitana",
		"newArchEnabled": true,
		"orientation": "portrait",
		"owner": "carrismetropolitana",
		"plugins": [
			"@maplibre/maplibre-react-native",
			[
				"expo-notifications",
				{
					"enableBackgroundRemoteNotifications": true
				}
			],
			"expo-router",
			[
				"expo-splash-screen",
				{
					"backgroundColor": "#ffffff",
					"dark": {
						"backgroundColor": "#1e1e28",
						"image": "./assets/images/Logos/CM_Logo_DarkMode.png"
					},
					"image": "./assets/images/Logos/CM_Logo_LightMode.png",
					"imageWidth": 200,
					"resizeMode": "contain"
				}
			],
			[
				"expo-font",
				{
					"fonts": [
						"./assets/fonts/Inter-VariableFont_opsz,wght.ttf",
						"./assets/fonts/SpaceMono-Regular.ttf"
					]
				}
			],
			[
				"expo-location",
				{
					"locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location."
				}
			],
			[
				"expo-asset",
				{
					"assets": [
						"./assets"
					]
				}
			],
			"expo-localization",
			"expo-audio"
		],
		"runtimeVersion": {
			"policy": "appVersion"
		},
		"scheme": "carrismetropolitana",
		"slug": "app",
		"updates": {
			"url": "https://u.expo.dev/43d60702-1266-4217-8cb8-54e1f9a722fe"
		},
		"userInterfaceStyle": "automatic",
		"version": "2025.09.10",
		"web": {
			"bundler": "metro",
			"favicon": "./assets/images/adaptive-icon.png",
			"output": "static"
		}
	}
}
